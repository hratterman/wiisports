# Copy to host/macmini/wiisports.env and fill in. wiisports.env is git-ignored; keep it private.

# Where the toolchain, build output, site and logs go (about 15 GB).
WSR_HOME="$HOME/wiisports-host"

# The disc: either a file already on this Mac...
WSR_DISC=""
# ...or a Google Drive share link to the RVZ (or a zip holding it). Share it as
# "Anyone with the link" while setup runs, then switch it back to Restricted.
WSR_DISC_URL=""

# Public address, and who may log in (only used when recreating the Cloudflare side).
WSR_HOSTNAME="wii.henryratterman.com"
WSR_ALLOW_EMAILS=""

# Port wsr-host listens on, on 127.0.0.1 only. Change it if 8080 is taken.
WSR_PORT=8080

# The tunnel token from Henry. The tunnel, DNS record and Access login already exist.
WSR_TUNNEL_TOKEN=""

# Only to recreate the Cloudflare side from scratch (leave empty otherwise): an API token and the
# account ID; see host/macmini/README.md for the token's permissions.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
